{
  "name": "dsh-deskbridge",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin exposing the agent-desktop CLI: desktop observation and ref-based interaction tools for AI agents",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-desktop",
    "computer-use",
    "desktop-automation",
    "accessibility",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-PRd/deskbridge.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.0.6-alpha.1 || ~4.1.0",
    "@deepseek-ai/dsh-computer-use": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.18.6-alpha.1 || ~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-computer-use": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
